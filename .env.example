# Supabase - Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Server-side only (Vercel env, Production/Preview/Development as appropriate). Never NEXT_PUBLIC_.
# HMAC secret shared with the database (public.inquiry_signing_secret, migration 31). 32+ random characters; the same value
# in both places. Without it /api/inquiries sends no proof and the database cannot trust the visitor's network address.
INQUIRY_HMAC_SECRET=
