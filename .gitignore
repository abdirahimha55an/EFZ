# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# generated by scripts/inquiry-forms-dom-test (esbuild bundles of the real components)
scripts/inquiry-forms-dom-test/.*bundle.cjs
scripts/order-form-dom-test/.*bundle.cjs
scripts/product-designs-dom-test/.*bundle.cjs

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# real customer data - never commit
/Backup/
/Dev/
/supabase/06_data_import.sql
**/06_data_import.sql

# Supabase CLI local state (project link, CLI version)
supabase/.temp/

# test run output
supabase/checks/*/_run.*

# scratch files holding a generated secret during Staging verification (docs/STAGING_VERIFICATION_INQUIRIES.md)
.inquiry-secret*
