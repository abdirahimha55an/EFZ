# Migration 18 SQL and its generator inputs are executed and hashed byte for byte:
# keep them LF in every checkout, on every platform (core.autocrlf would otherwise
# turn them into CRLF on Windows, and psql would carry the CRs into function bodies).
supabase/18*.sql            text eol=lf
supabase/rollback/18*.sql   text eol=lf
supabase/production/m18/**  text eol=lf
supabase/staging/staging_checks_18.sql  text eol=lf
# Migration 20 (payment terms): same rule, the applied file is pinned by sha256.
supabase/20*.sql            text eol=lf
supabase/rollback/20*.sql   text eol=lf
supabase/checks/20*.sql     text eol=lf

# Release 19-29: every migration, rollback, check and production script is applied byte for byte; keep LF everywhere (see docs/PRODUCTION_LAUNCH_PACKAGE.md, "line endings").
supabase/*.sql              text eol=lf
supabase/rollback/*.sql     text eol=lf
supabase/checks/*.sql       text eol=lf
supabase/production/*       text eol=lf
supabase/production/rehearsal/* text eol=lf
